# Which model to use: openai or ollama
LLM_PROVIDER=openai

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Put today's prices here to see the cost of every request in the logs.
# Leave them at 0 to skip the estimate.
OPENAI_INPUT_PRICE_PER_MILLION=0
OPENAI_OUTPUT_PRICE_PER_MILLION=0

# Ollama settings, used when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.3

# USDA FoodData Central settings
# Get a free key from https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY works but it is limited to 30 requests per hour.
USDA_API_KEY=DEMO_KEY
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_TIMEOUT_SECONDS=30

# ExerciseDB settings
# This host is free and open, it needs no key.
EXERCISEDB_BASE_URL=https://oss.exercisedb.dev/api/v1
EXERCISEDB_TIMEOUT_SECONDS=30

# Logging settings
LOG_LEVEL=INFO
LOG_FOLDER=logs
LOG_TO_CONSOLE=true
LOG_FULL_PAYLOADS=true
LOG_USER_DETAILS=true

# API settings
APP_NAME=Personal Trainer Agent
APP_VERSION=1.0.0
